<!DOCTYPE html>
<html>
<head>
  <title>review</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", media: "all", "data-turbo-track": "reload" %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-..." crossorigin="anonymous">
</head>
<body class="index">

<%= render "common/header" %>

<h2>Danh sách review</h2>

<%= render "common/notice" %>

     <div class="table-container">
      <table>
        <thead>
        <tr>
          <th>Họ tên</th>
          <th>Star</th>
          <th>Comment</th>
          <% if current_user.role == 'student' %>
          <th class="text-center">Action</th>
          <%end %>
        </tr>
        </thead>
        <tbody>
        <% @requests.each do |sup| %>
          <tr>
            <td><%= "#{sup.user_full_name} - #{sup.subject}" %></td>

            <% if sup.review_id.present? %>
              <td>
                <% sup.star_before_type_cast.times do %>
                  ⭐
                <% end %>
              </td>
              <td><%= sup.comment %></td>
              <% if current_user.role == 'student' %>
                <td></td>
              <%end %>
            <% elsif current_user.role == 'student' %>
              <%= form_with url: review_create_path, scope: :review, method: :post, local: true do |f| %>
                <td>
                  <%= f.select :star,
                               Review.stars.keys.map { |k| [k.humanize, k] },
                               {},
                               class: "form-select" %>
                </td>

                <td>
                  <%= f.text_field :comment,
                                   class: "form-control",
                                   placeholder: "Nhập nhận xét..." %>
                </td>

                <td class="text-center">
                  <%= f.hidden_field :request_id, value: sup.id %>
                  <%= f.submit "Gửi review", class: "btn btn-primary btn-sm" %>
                </td>
              <% end %>

            <% elsif current_user.role == 'teacher' %>
              <td>...</td>
              <td>Chưa có nhận xét</td>
            <% end %>
          </tr>
        <% end %>


        </tbody>
      </table>
    </div>

</body>
</html>

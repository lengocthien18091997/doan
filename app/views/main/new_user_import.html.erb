<!DOCTYPE html>
<html>
<head>
  <title>Import Users</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", media: "all", "data-turbo-track": "reload" %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-..." crossorigin="anonymous">
</head>
<body class="index">
<%= render "common/header" %>

<h2>Import user</h2>

<main class="registration-export-page">
  <p>Chọn tệp CSV chứa các trường: full_name, email, password, is_lock, phone_number, role, gender, date_of_birth, contract_confirmed</p>
  <%= form_with url: user_import_create_path, multipart: true, local: true do |f| %>
    <div class="mb-3">
      <%= f.file_field :csv_file, accept: ".csv", class: "form-control" %>
    </div>
    <div class="mb-3">
      <%= f.submit "Nhập user", class: "btn btn-primary" %>
      <%= link_to "Quay lại", root_path, class: "btn btn-secondary" %>
    </div>
  <% end %>
</main>
</body>
</html>

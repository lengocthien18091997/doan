<header class="app-header">
  <%= link_to root_path, class: "app-brand", aria: { label: "VnEdu" } do %>
    <%= image_tag "logo.jpg", alt: "VnEdu", class: "app-brand__logo" %>
    <span><%= dashboard_title_for(current_user&.role) %></span>
  <% end %>

  <% if current_user %>
    <nav class="header-nav" aria-label="Primary navigation">
      <%= link_to dashboard_path, class: "header-nav__link #{'active' if current_page?(dashboard_path)}" do %>
        <%= ui_icon(:dashboard, size: 19) %>
        <span>Dashboard</span>
      <% end %>

      <%= link_to root_path, class: "header-nav__link #{'active' if current_page?(root_path)}" do %>
        <%= ui_icon(:tutors, size: 19) %>
        <%if current_user.role == "student" %>
          <span>List teacher</span>
        <% elsif current_user.role == "teacher"%>
          <span>List request</span>
        <%else %>
          <span>List users</span>
        <% end %>
      <% end %>

      <%= link_to review_list_path, class: "header-nav__link #{'active' if current_page?(review_list_path)}" do %>
        <%= ui_icon(:reviews, size: 19) %>
        <span>Reviews</span>
      <% end %>
      <% if current_user.role != 'admin' %>
        <%= link_to request_list_path, class: "header-nav__link #{'active' if current_page?(request_list_path)}" do %>
          <%= ui_icon(:invite, size: 19) %>
          <span>Request</span>
        <% end %>

        <%= link_to timetable_path, class: "header-nav__link #{'active' if current_page?(timetable_path)}" do %>
          <%= ui_icon(:schedule, size: 19) %>
          <span>Schedule</span>
        <% end %>

        <%= link_to tuition_path, class: "header-nav__link #{'active' if current_page?(tuition_path)}" do %>
          <%= ui_icon(:payments, size: 19) %>
          <span>Payments</span>
        <% end %>
      <% end %>
      <%= link_to support_path, method: :get, class: "header-nav__link #{'active' if current_page?(support_path)}" do %>
        <%= ui_icon(:invite, size: 19) %>
        <span>Help</span>
      <% end %>
    </nav>

    <details class="user-menu">
      <summary class="user-summary" aria-label="User menu">
        <span class="user-avatar"><%= avatar_initials(current_user) %></span>
        <%= ui_icon(:chevron, size: 18, class: "user-summary__chevron") %>
      </summary>

      <div class="user-menu-items">
        <div class="user-menu__identity">
          <span class="user-avatar user-avatar--small"><%= avatar_initials(current_user) %></span>
          <div>
            <strong><%= current_user.full_name %></strong>
            <small><%= current_user.role.to_s.titleize %></small>
          </div>
        </div>

        <%= link_to user_update_path, class: "user-menu__link" do %>
          <%= ui_icon(:profile, size: 18) %>
          <span>Thông tin cá nhân</span>
        <% end %>

        <%= button_to logout_path, method: :delete, class: "user-menu__link user-menu__button" do %>
          <%= ui_icon(:logout, size: 18) %>
          <span>Đăng xuất</span>
        <% end %>
      </div>
    </details>
  <% else %>
    <div class="guest-actions">
      <%= link_to "Đăng nhập", login_path, class: "btn btn-secondary btn-sm" %>
      <%= link_to "Đăng kí", register_path, class: "btn btn-primary btn-sm" %>
    </div>
  <% end %>
</header>
